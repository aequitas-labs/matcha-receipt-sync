{
  "manifest_version": 3,
  "name": "receipt sync by matcha money",
  "version": "0.9.0",
  "description": "Export digital receipts to CSV/JSON, or sync them to matcha money to help develop your ritual for financial wellness.",
  "permissions": ["storage", "alarms", "cookies", "tabs"],
  "host_permissions": [
    "https://www.amazon.com/*",
    "https://www.costco.com/*",
    "https://ecom-api.costco.com/*",
    "https://www.walmart.com/*",
    "https://www.target.com/*",
    "https://api.target.com/*",
    "https://matcha.money/*",
    "https://us.i.posthog.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.com/your-orders*",
        "https://www.amazon.com/gp/your-account/order-history*",
        "https://www.amazon.com/gp/css/order-history*"
      ],
      "js": ["content-amazon-main.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.amazon.com/your-orders*",
        "https://www.amazon.com/gp/your-account/order-history*",
        "https://www.amazon.com/gp/css/order-history*"
      ],
      "js": ["content-amazon.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.costco.com/OrderStatusCmd*",
        "https://www.costco.com/myaccount/*"
      ],
      "js": ["content-costco-main.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.costco.com/OrderStatusCmd*",
        "https://www.costco.com/myaccount/*"
      ],
      "js": ["content-costco.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.walmart.com/orders*",
        "https://www.walmart.com/account/orders*"
      ],
      "js": ["content-walmart-main.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.walmart.com/orders*",
        "https://www.walmart.com/account/orders*"
      ],
      "js": ["content-walmart.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.target.com/orders*",
        "https://www.target.com/account/orders*"
      ],
      "js": ["content-target-main.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.target.com/orders*",
        "https://www.target.com/account/orders*"
      ],
      "js": ["content-target.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
